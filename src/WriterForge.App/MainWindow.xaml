<RibbonWindow x:Class="WriterForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WriterForge.App"
        xmlns:editor="clr-namespace:WriterForge.Editor.Controls;assembly=WriterForge.Editor"
        xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        mc:Ignorable="d"
        Title="WriterForge" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <RibbonWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.NewDocumentCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:MainWindow.OpenDocumentCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.SaveDocumentCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.SaveDocumentAsCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FindCommand}"/>
        <KeyBinding Key="H" Modifiers="Control" Command="{x:Static local:MainWindow.ReplaceCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="Print"/>
    </RibbonWindow.InputBindings>

    <RibbonWindow.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NewDocumentCommand}" Executed="NewDocument_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.OpenDocumentCommand}" Executed="OpenDocument_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveDocumentCommand}" Executed="SaveDocument_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveDocumentAsCommand}" Executed="SaveDocumentAs_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.FindCommand}" Executed="Find_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.ReplaceCommand}" Executed="Replace_Executed"/>
        <CommandBinding Command="Print" Executed="Print_Executed"/>
        <CommandBinding Command="PrintPreview" Executed="PrintPreview_Executed"/>

        <CommandBinding Command="Undo" Executed="Undo_Executed" CanExecute="EditCommand_CanExecute"/>
        <CommandBinding Command="Redo" Executed="Redo_Executed" CanExecute="EditCommand_CanExecute"/>
        <CommandBinding Command="Cut" Executed="Cut_Executed" CanExecute="EditCommand_CanExecute"/>
        <CommandBinding Command="Copy" Executed="Copy_Executed" CanExecute="EditCommand_CanExecute"/>
        <CommandBinding Command="Paste" Executed="Paste_Executed" CanExecute="EditCommand_CanExecute"/>
        <CommandBinding Command="SelectAll" Executed="SelectAll_Executed" CanExecute="EditCommand_CanExecute"/>
    </RibbonWindow.CommandBindings>

    <RibbonWindow.Resources>
        <!-- The ribbon renders a default application-menu button even with no
             ApplicationMenu set; File is a real tab, so hide it. -->
        <Style TargetType="ribbon:RibbonApplicationMenu">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </RibbonWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Ribbon Grid.Row="0" x:Name="MainRibbon" SelectionChanged="MainRibbon_SelectionChanged">
            <!-- File tab: opens the backstage overlay (handled in code-behind) -->
            <RibbonTab x:Name="FileTab" Header="File">
                <RibbonGroup Header="File">
                    <RibbonButton Label="File options" ToolTip="Open, save, export, print" Click="FileTab_Click"/>
                </RibbonGroup>
            </RibbonTab>

            <!-- ================= HOME ================= -->
            <RibbonTab x:Name="HomeTab" Header="Home">
                <RibbonGroup Header="Clipboard">
                    <RibbonButton x:Name="UndoBtn" Label="Undo" ToolTip="Undo (Ctrl+Z)" Click="RibbonUndo_Click"/>
                    <RibbonButton x:Name="RedoBtn" Label="Redo" ToolTip="Redo (Ctrl+Y)" Click="RibbonRedo_Click"/>
                    <RibbonButton Label="Cut" ToolTip="Cut (Ctrl+X)" Command="Cut"/>
                    <RibbonButton Label="Copy" ToolTip="Copy (Ctrl+C)" Command="Copy"/>
                    <RibbonButton Label="Paste" ToolTip="Paste (Ctrl+V)" Command="Paste"/>
                </RibbonGroup>

                <RibbonGroup Header="Font">
                    <ComboBox x:Name="FontBox" ToolTip="Font" Width="150" SelectionChanged="FontBox_SelectionChanged">
                        <ComboBoxItem Content="Georgia" Tag="Georgia"/>
                        <ComboBoxItem Content="Times New Roman" Tag="Times New Roman"/>
                        <ComboBoxItem Content="Arial" Tag="Arial"/>
                        <ComboBoxItem Content="Calibri" Tag="Calibri"/>
                        <ComboBoxItem Content="Verdana" Tag="Verdana"/>
                        <ComboBoxItem Content="Courier New" Tag="Courier New"/>
                        <ComboBoxItem Content="Garamond" Tag="Garamond"/>
                    </ComboBox>
                    <ComboBox x:Name="SizeBox" ToolTip="Font size" Width="60" SelectionChanged="SizeBox_SelectionChanged">
                        <ComboBoxItem Content="8" Tag="8"/>
                        <ComboBoxItem Content="9" Tag="9"/>
                        <ComboBoxItem Content="10" Tag="10"/>
                        <ComboBoxItem Content="11" Tag="11"/>
                        <ComboBoxItem Content="12" Tag="12"/>
                        <ComboBoxItem Content="14" Tag="14"/>
                        <ComboBoxItem Content="16" Tag="16"/>
                        <ComboBoxItem Content="18" Tag="18"/>
                        <ComboBoxItem Content="20" Tag="20"/>
                        <ComboBoxItem Content="24" Tag="24"/>
                        <ComboBoxItem Content="28" Tag="28"/>
                        <ComboBoxItem Content="32" Tag="32"/>
                        <ComboBoxItem Content="36" Tag="36"/>
                        <ComboBoxItem Content="48" Tag="48"/>
                        <ComboBoxItem Content="72" Tag="72"/>
                    </ComboBox>
                    <RibbonToggleButton x:Name="BoldToggle" Label="B" ToolTip="Bold (Ctrl+B)" FontWeight="Bold" Click="Bold_Click"/>
                    <RibbonToggleButton x:Name="ItalicToggle" Label="I" ToolTip="Italic (Ctrl+I)" FontStyle="Italic" Click="Italic_Click"/>
                    <RibbonToggleButton x:Name="UnderlineToggle" Label="U" ToolTip="Underline (Ctrl+U)" Click="Underline_Click"/>
                    <RibbonToggleButton x:Name="StrikeToggle" Label="S" ToolTip="Strikethrough" Click="Strike_Click"/>
                    <RibbonToggleButton x:Name="SubToggle" Label="x₂" ToolTip="Subscript" Click="Sub_Click"/>
                    <RibbonToggleButton x:Name="SupToggle" Label="x²" ToolTip="Superscript" Click="Sup_Click"/>
                    <RibbonButton x:Name="FontColorBtn" Label="A" ToolTip="Font colour" Click="FontColor_Click"/>
                    <RibbonButton x:Name="HighlightBtn" Label="ab" ToolTip="Highlight colour" Click="Highlight_Click"/>
                    <RibbonButton Label="Clear" ToolTip="Clear formatting" Click="ClearFormatting_Click"/>
                </RibbonGroup>

                <RibbonGroup Header="Paragraph">
                    <ComboBox x:Name="StyleBox" ToolTip="Paragraph style" Width="130" SelectionChanged="StyleBox_SelectionChanged">
                        <ComboBoxItem Content="Normal" Tag="StyleNormal"/>
                        <ComboBoxItem Content="Heading 1" Tag="StyleHeading1"/>
                        <ComboBoxItem Content="Heading 2" Tag="StyleHeading2"/>
                        <ComboBoxItem Content="Heading 3" Tag="StyleHeading3"/>
                        <ComboBoxItem Content="Quote" Tag="StyleQuote"/>
                        <ComboBoxItem Content="Caption" Tag="StyleCaption"/>
                    </ComboBox>
                    <RibbonToggleButton x:Name="AlignLeftToggle" Label="Left" ToolTip="Align left" Click="AlignLeft_Click"/>
                    <RibbonToggleButton x:Name="AlignCenterToggle" Label="Centre" ToolTip="Align centre" Click="AlignCenter_Click"/>
                    <RibbonToggleButton x:Name="AlignRightToggle" Label="Right" ToolTip="Align right" Click="AlignRight_Click"/>
                    <RibbonToggleButton x:Name="AlignJustifyToggle" Label="Justify" ToolTip="Justify" Click="AlignJustify_Click"/>
                    <RibbonToggleButton x:Name="BulletsToggle" Label="• List" ToolTip="Bulleted list" Click="Bullets_Click"/>
                    <RibbonToggleButton x:Name="NumbersToggle" Label="1. List" ToolTip="Numbered list" Click="Numbers_Click"/>
                </RibbonGroup>
            </RibbonTab>

            <!-- ================= INSERT ================= -->
            <RibbonTab Header="Insert">
                <RibbonGroup Header="Illustrations">
                    <RibbonButton Label="Picture" ToolTip="Insert image" Click="InsertImage_Click"/>
                </RibbonGroup>
                <RibbonGroup Header="Tables">
                    <RibbonButton Label="Table..." ToolTip="Insert table" Click="InsertTable_Click"/>
                    <RibbonButton Label="Insert Row Below" Click="InsertRowBelow_Click"/>
                    <RibbonButton Label="Insert Row Above" Click="InsertRowAbove_Click"/>
                    <RibbonButton Label="Insert Column Right" Click="InsertColRight_Click"/>
                    <RibbonButton Label="Insert Column Left" Click="InsertColLeft_Click"/>
                    <RibbonButton Label="Delete Row" Click="DeleteRow_Click"/>
                    <RibbonButton Label="Delete Column" Click="DeleteColumn_Click"/>
                </RibbonGroup>
                <RibbonGroup Header="Reference">
                    <RibbonButton Label="Table of Contents" ToolTip="Insert table of contents" Click="InsertToc_Click"/>
                    <RibbonButton Label="Footnote" ToolTip="Insert footnote" Click="InsertFootnote_Click"/>
                    <RibbonButton Label="Endnote" ToolTip="Insert endnote" Click="InsertEndnote_Click"/>
                    <RibbonButton Label="Delete Note" ToolTip="Delete footnote/endnote at caret" Click="DeleteNote_Click"/>
                    <RibbonButton Label="Convert Notes" ToolTip="Convert footnotes ↔ endnotes" Click="ConvertNotes_Click"/>
                    <RibbonButton Label="Renumber Notes" ToolTip="Renumber all notes" Click="RenumberNotes_Click"/>
                </RibbonGroup>
            </RibbonTab>

            <!-- ================= LAYOUT ================= -->
            <RibbonTab Header="Layout">
                <RibbonGroup Header="Paragraph">
                    <ComboBox x:Name="SpacingBox" ToolTip="Line spacing" Width="80" SelectionChanged="SpacingBox_SelectionChanged">
                        <ComboBoxItem Content="Single" Tag="1" IsSelected="True"/>
                        <ComboBoxItem Content="1.15" Tag="1.15"/>
                        <ComboBoxItem Content="1.5" Tag="1.5"/>
                        <ComboBoxItem Content="Double" Tag="2"/>
                    </ComboBox>
                    <ComboBox x:Name="BeforeBox" ToolTip="Space before paragraph" Width="75" SelectionChanged="BeforeBox_SelectionChanged">
                        <ComboBoxItem Content="Auto" Tag="" IsSelected="True"/>
                        <ComboBoxItem Content="0 pt" Tag="0"/>
                        <ComboBoxItem Content="6 pt" Tag="6"/>
                        <ComboBoxItem Content="12 pt" Tag="12"/>
                        <ComboBoxItem Content="18 pt" Tag="18"/>
                    </ComboBox>
                    <ComboBox x:Name="AfterBox" ToolTip="Space after paragraph" Width="75" SelectionChanged="AfterBox_SelectionChanged">
                        <ComboBoxItem Content="Auto" Tag="" IsSelected="True"/>
                        <ComboBoxItem Content="0 pt" Tag="0"/>
                        <ComboBoxItem Content="6 pt" Tag="6"/>
                        <ComboBoxItem Content="12 pt" Tag="12"/>
                        <ComboBoxItem Content="18 pt" Tag="18"/>
                    </ComboBox>
                    <RibbonButton Label="→|" ToolTip="Increase indent" Click="IndentRight_Click"/>
                    <RibbonButton Label="←|" ToolTip="Decrease indent" Click="IndentLeft_Click"/>
                </RibbonGroup>
                <RibbonGroup Header="Page Setup">
                    <RibbonButton Label="Page Setup..." ToolTip="Page size, margins, header and footer" Click="PageSetup_Click"/>
                </RibbonGroup>
            </RibbonTab>

            <!-- ================= VIEW ================= -->
            <RibbonTab Header="View">
                <RibbonGroup Header="Document Views">
                    <RibbonToggleButton x:Name="PrintLayoutToggle" Label="Print Layout" ToolTip="Edit directly on pages" IsChecked="False" Click="PrintLayoutToggle_Click"/>
                    <RibbonToggleButton x:Name="ReadModeToggle" Label="Read Mode" ToolTip="Page view without ribbon" IsChecked="False" Click="ReadModeToggle_Click"/>
                    <RibbonToggleButton x:Name="OutlineToggle" Label="Outline" ToolTip="Heading outline for restructuring" IsChecked="False" Click="OutlineToggle_Click"/>
                </RibbonGroup>
                <RibbonGroup Header="Show">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="NavCheck" Click="NavPaneToggle_Click" VerticalAlignment="Center"/>
                        <TextBlock Text="Navigation Pane" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="RulerCheck" Click="RulerToggle_Click" VerticalAlignment="Center"/>
                        <TextBlock Text="Ruler" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="GridCheck" Click="GridlinesToggle_Click" VerticalAlignment="Center"/>
                        <TextBlock Text="Gridlines" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </RibbonGroup>
            </RibbonTab>

            <!-- ================= REVIEW ================= -->
            <RibbonTab Header="Review">
                <RibbonGroup Header="Proofing">
                    <RibbonButton Label="Writing Analysis..." ToolTip="Repeated words, passive voice, adverbs" Click="Analysis_Click"/>
                    <RibbonButton Label="Statistics" ToolTip="Document statistics" Click="Statistics_Click"/>
                    <RibbonButton Label="Writing Progress..." ToolTip="Daily word counts and targets" Click="Progress_Click"/>
                    <RibbonButton Label="Page Count" ToolTip="Run pagination engine (debug)" Click="PageCount_Click"/>
                </RibbonGroup>
                <RibbonGroup Header="Typography">
                    <RibbonButton Label="Smart Quotes" Click="SmartQuotes_Click"/>
                    <RibbonButton Label="Normalise Ellipsis" Click="Ellipsis_Click"/>
                    <RibbonButton Label="Clean Whitespace" Click="Whitespace_Click"/>
                    <RibbonButton Label="Remove Empty Paragraphs" Click="EmptyParagraphs_Click"/>
                    <RibbonButton Label="Run All Typography" Click="AllTypography_Click"/>
                </RibbonGroup>
                <RibbonGroup Header="Automation">
                    <RibbonButton Label="Macro Recorder..." ToolTip="Record and replay actions" Click="MacroRecorder_Click"/>
                    <RibbonButton Label="Save Selection as Style..." Click="SaveStyle_Click"/>
                    <RibbonButton Label="Find..." ToolTip="Find and replace (Ctrl+F)" Command="{x:Static local:MainWindow.FindCommand}"/>
                    <RibbonButton Label="Replace..." ToolTip="Find and replace (Ctrl+H)" Command="{x:Static local:MainWindow.ReplaceCommand}"/>
                </RibbonGroup>
                <RibbonGroup Header="Settings">
                    <RibbonButton Label="Settings..." Click="Settings_Click"/>
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>

        <editor:EditorControl Grid.Row="1" x:Name="Editor"/>

        <!-- Word-style backstage: covers ribbon + editor when File tab is chosen -->
        <Border x:Name="BackstagePanel" Grid.Row="0" Grid.RowSpan="2"
                Visibility="Collapsed" Background="#FFF3F3F3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FFE1DFDD">
                    <StackPanel Margin="10,16">
                        <Button Content="←  Home" FontSize="15" FontWeight="SemiBold"
                                Padding="12,8" Margin="0,0,0,18" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Click="BackstageHome_Click"/>
                        <Separator Margin="0,0,0,10"/>
                        <Button Content="New" Padding="12,9" Margin="0,1" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Command="{x:Static local:MainWindow.NewDocumentCommand}"/>
                        <Button Content="Open" Padding="12,9" Margin="0,1" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Command="{x:Static local:MainWindow.OpenDocumentCommand}"/>
                        <Button Content="Save" Padding="12,9" Margin="0,1" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Command="{x:Static local:MainWindow.SaveDocumentCommand}"/>
                        <Button Content="Save As" Padding="12,9" Margin="0,1" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Command="{x:Static local:MainWindow.SaveDocumentAsCommand}"/>
                        <Separator Margin="0,10"/>
                        <Button Content="Export as PDF" Padding="12,9" Margin="0,1" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Click="ExportPdf_Click"/>
                        <Button Content="Print" Padding="12,9" Margin="0,1" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Command="Print"/>
                        <Button Content="Print Preview" Padding="12,9" Margin="0,1" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Command="PrintPreview"/>
                        <Button Content="Page Setup" Padding="12,9" Margin="0,1" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Click="PageSetup_Click"/>
                        <Separator Margin="0,10"/>
                        <Button Content="Exit" Padding="12,9" Margin="0,1" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Click="Exit_Click"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="48,36" MaxWidth="560">
                        <TextBlock Text="Info" FontSize="30" FontWeight="Light" Foreground="#FF323130"/>
                        <Separator Margin="0,14,0,22"/>
                        <TextBlock Text="Document" FontSize="13" FontWeight="SemiBold" Foreground="#FF605E5C"/>
                        <TextBlock x:Name="BsFileName" FontSize="20" Margin="0,4,0,2"/>
                        <TextBlock x:Name="BsFilePath" FontSize="12" Foreground="#FF605E5C" TextWrapping="Wrap"/>
                        <Separator Margin="0,20,0,16"/>
                        <TextBlock Text="Statistics" FontSize="13" FontWeight="SemiBold" Foreground="#FF605E5C"/>
                        <TextBlock x:Name="BsStats" FontSize="15" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</RibbonWindow>
