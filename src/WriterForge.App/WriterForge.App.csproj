<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>WriterForge</AssemblyTitle>
    <Product>WriterForge</Product>
    <Description>A word processor for fiction and non-fiction writers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriterForge.Editor\WriterForge.Editor.csproj" />
    <Resource Include="app.ico" />
    <None Include="Dictionaries\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
