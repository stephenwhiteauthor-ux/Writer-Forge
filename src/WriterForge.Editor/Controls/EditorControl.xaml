<UserControl x:Class="WriterForge.Editor.Controls.EditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="StyleNormal" TargetType="Paragraph"/>
        <Style x:Key="StyleHeading1" TargetType="Paragraph">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="StyleHeading2" TargetType="Paragraph">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="StyleHeading3" TargetType="Paragraph">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="StyleQuote" TargetType="Paragraph">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="48,6,48,6"/>
        </Style>
        <Style x:Key="StyleCaption" TargetType="Paragraph">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Document surface -->
        <RichTextBox x:Name="Document"
                     Grid.Row="0"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Georgia"
                     FontSize="14"
                     Padding="48,24">
            <FlowDocument PagePadding="0">
                <Paragraph/>
            </FlowDocument>
        </RichTextBox>

        <!-- Empty-document hint (non-editable overlay) -->
        <TextBlock x:Name="PlaceholderText" Grid.Row="1"
                   Text="Start writing…"
                   FontFamily="Georgia" FontSize="14" FontStyle="Italic"
                   Foreground="Gray"
                   Margin="52,30,0,0"
                   IsHitTestVisible="False"/>

        <!-- Status bar -->
        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Words: 0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
