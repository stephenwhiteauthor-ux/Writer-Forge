<UserControl x:Class="WriterForge.Editor.Controls.EditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WriterForge.Editor.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="StyleNormal" TargetType="Paragraph"/>
        <Style x:Key="StyleHeading1" TargetType="Paragraph">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="StyleHeading2" TargetType="Paragraph">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="StyleHeading3" TargetType="Paragraph">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="StyleQuote" TargetType="Paragraph">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="48,6,48,6"/>
        </Style>
        <Style x:Key="StyleCaption" TargetType="Paragraph">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Document surface: nav pane | (ruler + editor/page-view) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="NavPane" Grid.Column="0" Width="220"
                    Background="#FFF3F3F3" BorderBrush="#FFDDDDDD" BorderThickness="0,0,1,0"
                    Visibility="Collapsed">
                <DockPanel>
                    <TextBlock Text="Headings" FontWeight="SemiBold" Margin="10,8"
                               DockPanel.Dock="Top" Foreground="Gray"/>
                    <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                             SelectionChanged="NavList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Canvas x:Name="Ruler" Height="18" Margin="48,0,48,0"
                        Visibility="Collapsed" Background="#FFF7F7F7"
                        MouseLeftButtonDown="Ruler_MouseDown"
                        MouseMove="Ruler_MouseMove"
                        MouseLeftButtonUp="Ruler_MouseUp"/>

                <Grid Grid.Row="1">
                    <RichTextBox x:Name="Document"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Georgia"
                                 FontSize="14"
                                 Padding="48,24">
                        <FlowDocument PagePadding="0">
                            <Paragraph/>
                        </FlowDocument>
                    </RichTextBox>
                    <local:PagedPreview x:Name="PagePreview" Visibility="Collapsed"/>
                    <Border x:Name="OutlinePane" Visibility="Collapsed" Background="White">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#FFF3F3F3"
                                    BorderBrush="#FFDDDDDD" BorderThickness="0,0,0,1" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Promote" Padding="10,2" Margin="0,0,6,0"
                                            Click="OutlinePromote_Click" ToolTip="Move up one level (Alt+Shift+Left)"/>
                                    <Button Content="Demote" Padding="10,2" Margin="0,0,12,0"
                                            Click="OutlineDemote_Click" ToolTip="Move down one level (Alt+Shift+Right)"/>
                                    <Button Content="Move Up" Padding="10,2" Margin="0,0,6,0"
                                            Click="OutlineMoveUp_Click" ToolTip="Move section up"/>
                                    <Button Content="Move Down" Padding="10,2" Margin="0,0,12,0"
                                            Click="OutlineMoveDown_Click" ToolTip="Move section down"/>
                                    <TextBlock Text="Double-click an entry to edit it" Foreground="Gray"
                                               VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="OutlineList" BorderThickness="0" Background="Transparent"
                                     MouseDoubleClick="OutlineList_MouseDoubleClick"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Empty-document hint (non-editable overlay) -->
        <TextBlock x:Name="PlaceholderText" Grid.Row="1"
                   Text="Start writing…"
                   FontFamily="Georgia" FontSize="14" FontStyle="Italic"
                   Foreground="Gray"
                   Margin="52,30,0,0"
                   IsHitTestVisible="False"/>

        <!-- Status bar -->
        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Words: 0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="PageCountText" Text=""/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
