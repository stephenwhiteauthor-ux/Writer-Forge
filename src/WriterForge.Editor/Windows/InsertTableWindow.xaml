<Window x:Class="WriterForge.Editor.Windows.InsertTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert Table" Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <StackPanel Width="100" Margin="0,0,16,0">
                <TextBlock Text="Rows:" Margin="0,0,0,4"/>
                <TextBox x:Name="RowsBox" Text="3"/>
            </StackPanel>
            <StackPanel Width="100">
                <TextBlock Text="Columns:" Margin="0,0,0,4"/>
                <TextBox x:Name="ColsBox" Text="3"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Insert" Width="80" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
