<Window x:Class="WriterForge.Editor.Windows.WritingAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Writing Analysis" Width="560" Height="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <GroupBox Grid.Row="1" Header="Findings" Padding="6">
            <ListBox x:Name="FindingsList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Highlight all" Width="100" Margin="0,0,8,0" Click="Highlight_Click"/>
            <Button Content="Clear highlights" Width="110" Margin="0,0,8,0" Click="Clear_Click"/>
            <Button Content="Close" Width="70" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
