<Window x:Class="WriterForge.Editor.Windows.MacroRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macro Recorder" Width="460" Height="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Macro name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="NameBox" Text="My Macro"/>
        </DockPanel>

        <GroupBox Grid.Row="1" Header="Recorded actions" Padding="6">
            <ListBox x:Name="ActionsList"/>
        </GroupBox>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <WrapPanel>
                <Button x:Name="RecordButton" Content="● Record" Width="90" Margin="0,0,6,0" Click="Record_Click"/>
                <Button Content="Save…" Width="70" Margin="0,0,6,0" Click="Save_Click"/>
                <Button Content="Open…" Width="70" Margin="0,0,6,0" Click="Open_Click"/>
                <Button Content="Play" Width="60" Margin="0,0,6,0" Click="Play_Click"/>
                <Button Content="Clear" Width="60" Click="Clear_Click"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" FontSize="11" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>
